---
// No props or scripts needed for now
---
<nav class="fixed top-0 left-0 right-0 z-50 bg-[rgba(10,10,10,0.95)] backdrop-blur border-b border-[--border-color] px-8 py-4">
  <div class="max-w-[1200px] mx-auto flex justify-between items-center">
    <!-- Logo -->
    <div class="flex items-center gap-2 text-xl font-bold">
      <div class="w-10 h-10 rounded-md bg-gradient-to-br from-[--gradient-start] to-[--gradient-end] flex items-center justify-center font-extrabold text-base">
        DG
      </div>
      <span>Dan Glorioso</span>
    </div>

    <!-- Nav Links -->
    <ul class="flex gap-8 list-none">
      <li><a href="#home" class="nav-link active">Home</a></li>
      <li><a href="#about" class="nav-link">About</a></li>
      <li><a href="#experience" class="nav-link">Experience</a></li>
      <li><a href="#projects" class="nav-link">Projects</a></li>
      <li><a href="#contact" class="nav-link">Contact</a></li>
    </ul>
  </div>
</nav>

<style is:global>
  :root {
    --accent-blue: #4f46e5;
    --text-secondary: #a3a3a3;
    --border-color: #2a2a2a;
    --gradient-start: #4f46e5;
    --gradient-end: #7c3aed;
  }

  .nav-link {
    @apply relative text-[--text-secondary] font-medium transition-all duration-300;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    height: 2px;
    width: 0;
    background: var(--accent-blue);
    transition: width 0.3s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--accent-blue);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }
</style>

<script>
  if (typeof window !== 'undefined') {
    window.addEventListener('scroll', () => {
      const navLinks = document.querySelectorAll('.nav-link');
      const sections = document.querySelectorAll('section');
      let current = '';
      sections.forEach((section) => {
        const sectionTop = section.offsetTop;
        if (scrollY >= sectionTop - 200) {
          current = section.id;
        }
      });
      navLinks.forEach((link) => {
        link.classList.remove('active');
        if (link.getAttribute('href') === `#${current}`) {
          link.classList.add('active');
        }
      });
    });
  }
</script>
